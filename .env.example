# Stripe secrets (leave empty for “payments not configured” UI — never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SQLite (WAL). Container default; Neo mounts appdata → /data
SHOP_DB_PATH=/data/shop.sqlite

# Stripe Test price IDs (safe defaults; not secrets)
STRIPE_PRICE_KIT=price_1UFvgv1oIIxcEEBR67p9pqaf
STRIPE_PRICE_PUBLIC_IP=price_1UFviO1oIIxcEEBRE6vE1O4L
STRIPE_PRICE_AIRVPN=price_1UFvjR1oIIxcEEBR8aHsaXaA
STRIPE_PRICE_HERMES=price_1UFvke1oIIxcEEBR2ZyLrPyV
STRIPE_PRICE_BACKUPS=price_1UFvmL1oIIxcEEBRAVZNH5s7

# Public URL used for Checkout success/cancel redirects
SITE_URL=http://localhost:3000

# Admin UI (storefront stays public; Tinyauth is at Neo SWAG edge in production)
ADMIN_ENABLED=true
ADMIN_PATH=/admin
ADMIN_READ_ONLY=false

PORT=3000
TZ=Europe/Zurich
